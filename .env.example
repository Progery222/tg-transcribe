# Telegram
BOT_TOKEN=

# OpenAI — required if DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TIMEOUT=120

# Gemini — required if DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TIMEOUT=120

# Default model applied to fresh chats. Switchable per-chat by group admins via /model.
# Supported (provider, model):
#   openai gpt-4o-mini-transcribe   (fast / cheap; default)
#   openai gpt-4o-transcribe        (accurate)
#   openai whisper-1                (legacy fallback; reliable language detection)
#   gemini gemini-2.5-flash
#   gemini gemini-2.5-pro
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini-transcribe

# Concurrency / limits
MAX_CONCURRENT_TRANSCRIPTIONS=3
MAX_FILE_BYTES=20971520           # 20 MB — Telegram Bot API getFile cap

# v2 — Access control + DM fanout + daily digest
BOT_ADMIN_IDS=                    # comma-separated Telegram user IDs of bot owners
DM_SEND_DELAY_MS=50               # ms between consecutive DMs (Telegram flood guard)
DIGEST_HOUR=10                    # daily digest send hour
DIGEST_MINUTE=0
DIGEST_TZ=Europe/Moscow
DIGEST_WINDOW_HOURS=24
INVITE_TTL_HOURS=72               # /invite link lifetime; 0 disables expiry (set via code)

# Runtime
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
LOG_JSON=false
BOT_MODE=polling                  # polling | webhook (webhook not implemented yet)
